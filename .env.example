# Copy to .env (ideally one directory ABOVE public_html, e.g. /home/USER/.env) and fill in.
APP_NAME="Mail CRM"
APP_URL=https://crm.example.com
APP_ENV=production
APP_TIMEZONE=UTC
# Force HTTPS redirects and Secure cookies (set false only for local http development)
FORCE_HTTPS=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_crm
DB_USERNAME=u123456789_crm
DB_PASSWORD=

# Generate with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ENCRYPTION_KEY=
CRON_SECRET=
WEBHOOK_SECRET=

# Max attachment / CSV upload size in MB
UPLOAD_LIMIT=10
# Optional absolute path for uploaded files outside public_html (default: ./uploads)
UPLOAD_PATH=

# Mailbox used for system emails (password resets). Leave blank to use PHP mail().
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_ENCRYPTION=tls
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_FROM_EMAIL=no-reply@example.com
SYSTEM_FROM_NAME="Mail CRM"

# Optional Gmail / Google Workspace OAuth (Google Cloud Console → OAuth client, type "Web application")
# Authorized redirect URI: {APP_URL}/mail-accounts/oauth.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow new users to self-register (the first user can always register)
ALLOW_REGISTRATION=true
