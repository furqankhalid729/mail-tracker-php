# Mail CRM — Apache configuration (works on Hostinger / cPanel shared hosting)

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (comment out for local http development)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass the Authorization header to PHP (needed for "Bearer" cron/webhook auth on CGI/FPM)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never serve internal directories
    RewriteRule ^(config|includes|vendor|storage|uploads|scripts|deploy|node_modules)(/|$) - [F,L]

    # Partials (_form.php, _save.php, _bootstrap.php) are include-only
    RewriteRule (^|/)_[^/]*\.php$ - [F,L]

    # Dotfiles (.env, .git …) except .well-known
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# Sensitive files by name
<FilesMatch "(^\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|database\.sql|README\.md|.*\.log|.*\.sql|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Production PHP settings (ignored where the host disallows php_flag in .htaccess — set them in hPanel instead)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
